# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_PATH=gradient.db
MAX_CSV_ROWS=100000
MAX_FILE_SIZE_MB=50

# ── Evaluation ────────────────────────────────────────────────────────────────
# Options: heuristic | exact_match | task_router | llm_judge
EVALUATOR_MODE=heuristic

# ── Provider API keys ─────────────────────────────────────────────────────────
# Set REAL_PROVIDER_MODE=true and at least one key to enable live replay calls.
REAL_PROVIDER_MODE=false
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── LLM judge (used when EVALUATOR_MODE=llm_judge) ───────────────────────────
LLM_JUDGE_MODEL=gpt-4o-mini
LLM_JUDGE_PROVIDER=openai
